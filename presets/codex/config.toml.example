# Codex 설정 예시 — calendar-worklog
#
# 배치 위치: ~/.codex/config.toml
# 아래 블록을 본인 config.toml에 병합하세요.
#
# 검증 메모(2026-05): 실제 Codex(데스크톱 앱)는 데이터 소스를 "OpenAI 큐레이티드
# 플러그인 커넥터"로 연결합니다. Claude 커넥터 / ChatGPT Apps와 같은 OAuth 토글 방식이며,
# 보통 앱 UI에서 켜면 아래 [plugins."..."] 줄이 자동으로 기록됩니다.
# (구버전 문서의 "npx로 서드파티 MCP 서버를 직접 띄운다"는 방식은 이 경우 불필요합니다.)

# === 1. 큐레이티드 플러그인 (주 경로) ===========================================
# 앱 UI(플러그인/커넥터 목록)에서 토글하면 아래가 자동 기록됨. 수동 편집도 가능.
# 토글 후 각 커넥터의 OAuth "Connect"를 승인해야 실제로 동작함.

[plugins."google-calendar@openai-curated"]
enabled = true   # 이벤트 읽기/쓰기. 필수

[plugins."slack@openai-curated"]
enabled = true   # 본인 메시지 검색. 강력 권장

[plugins."monday-com@openai-curated"]
enabled = true   # 보드 활동/Time Tracking. 회사 어드민이 AI 커넥터를 허용해야 동작

# === 2. 커스텀 MCP 서버 (큐레이티드 플러그인이 없는 소스만) ======================
# 큐레이티드 플러그인으로 제공되지 않는 소스가 있을 때만 직접 등록합니다.
# 형식 참고: command + args, 환경변수는 [mcp_servers.<name>.env] 서브테이블 사용.
# (env_vars = ["NAME"] 같은 리스트 형식이 아님)
#
# [mcp_servers.some_server]
# command = "npx"
# args = ["-y", "<실제-패키지명>"]      # 공식 문서에서 확인, 예시값 그대로 쓰지 말 것
# startup_timeout_sec = 120
#
# [mcp_servers.some_server.env]
# SOME_TOKEN = "<실제-토큰>"            # 민감값은 config에 평문 저장 주의
